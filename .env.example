# ---- Core -------------------------------------------------------------------
# set to "production" in production
APP_ENV=development
# public URL, used when generating customer links
APP_BASE_URL=http://localhost:8000
# python -m app.cli generate-secret
SECRET_KEY=
# python -m app.cli generate-key   (AES-256; BACK THIS UP)
KYC_ENCRYPTION_KEY=
# comma-separated retired keys, kept for decryption only
KYC_ENCRYPTION_OLD_KEYS=
# true behind HTTPS
SESSION_HTTPS_ONLY=false
# e.g. kyc.example.com
ALLOWED_HOSTS=*

# ---- Storage ------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (default: SQLite in ./storage)
# STORAGE_DIR=/var/lib/kyc-portal

# ---- Yativo -------------------------------------------------------------------
# production: https://kyc.yativo.com
YATIVO_KYC_BASE_URL=https://kyc-sandbox.yativo.com
# not required today; sent as Bearer if set
YATIVO_API_TOKEN=
YATIVO_TIMEOUT_SECONDS=180
LOOKUP_CACHE_TTL_SECONDS=21600

# ---- Address autocomplete -------------------------------------------------------
# With a key, Google Places API (New) is used via a server-side proxy (key never sent to browsers).
# Without one, a free OpenStreetMap geocoder is used automatically.
GOOGLE_MAPS_API_KEY=

# ---- Files ---------------------------------------------------------------------
FILE_MIN_KB=120
FILE_MAX_KB=3072
MAX_RAW_UPLOAD_MB=100

# ---- Customer links ------------------------------------------------------------
# When set, links need ?sig=… (generate them in the admin "Customer links" page or the CLI).
LINK_SIGNING_SECRET=

# ---- Admin -----------------------------------------------------------------------
# first admin, created on first start if none exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_MINUTES=60

# ---- Email (one-time codes for returning customers) -------------------------------
# Without SMTP, codes are printed to the server log in development (never in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
